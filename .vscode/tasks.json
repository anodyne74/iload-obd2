{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "clean-build",
            "type": "shell",
            "command": "go clean; if ($?) { go build -v }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": false,
                "close": false
            },
            "problemMatcher": ["$go"]
        },
        {
            "label": "kill-dlv",
            "type": "shell",
            "windows": {
                "command": "cmd.exe",
                "args": [
                    "/C",
                    "taskkill /F /IM dlv.exe /T 2>nul || exit /b 0"
                ]
            },
            "presentation": {
                "reveal": "silent",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "build-and-run",
            "type": "shell",
            "command": "go build -v; if ($?) { .\\iload-obd2.exe -config config.yaml }",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": ["$go"]
        },
        {
            "label": "run-tcp-simulator",
            "type": "shell",
            "command": "go run .\\testing\\cmd\\simulator_tcp\\main.go",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": ["$go"]
        },
        {
            "label": "run-windows-simulator",
            "type": "shell",
            "command": "go run .\\testing\\cmd\\simulator_windows\\main.go",
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": ["$go"]
        },
        {
            "label": "test",
            "type": "shell",
            "command": "go test ./... -v",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": ["$go"]
        },
        {
            "label": "build-pi",
            "type": "shell",
            "windows": {
                "command": "cmd",
                "args": [
                    "/C",
                    "set CGO_ENABLED=1&&set GOOS=linux&&set GOARCH=arm64&&go build -o build/iload-obd2"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$go"
        },
        {
            "label": "deploy-pi",
            "type": "shell",
            "windows": {
                "command": "cmd",
                "args": [
                    "/C",
                    "scp build/iload-obd2 pi@${input:piAddress}:/tmp/ && ssh pi@${input:piAddress} \"sudo bash -c 'systemctl stop iload-obd2 && mv /tmp/iload-obd2 /opt/iload-obd2/bin/ && systemctl start iload-obd2'\""
                ]
            },
            "dependsOn": ["build-pi"],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "piAddress",
            "type": "promptString",
            "description": "Raspberry Pi IP address",
            "default": "raspberrypi.local"
        }
    ]
}
